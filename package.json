{
  "name": "tehs-document-db",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "preinstall": "npx only-allow@1.2.2 bun",
    "build": "bun run docs:build && sanity build && bun run docs:dist",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "deploy:worker": "bun run build && wrangler deploy",
    "dev": "sanity dev",
    "docs:build": "bun run --cwd documentation build",
    "docs:dist": "rm -rf dist/documentation dist/_redirects && cp -R documentation/build dist/documentation",
    "docs:dev": "bun run --cwd documentation start",
    "docs:serve": "bun run --cwd documentation serve",
    "preview:worker": "wrangler dev",
    "csv-import": "bun run migrations/csv-import/import-documents.ts",
    "csv-import:donations": "bun run migrations/csv-import/import-donations.ts",
    "csv-import:images": "bun run migrations/csv-import/import-images.ts",
    "csv-import:image-identifiers": "bun run migrations/csv-import/import-image-identifiers.ts",
    "csv-import:images-review-reports": "bun run migrations/csv-import/generate-image-review-reports.ts",
    "csv-import:documents-review-reports": "bun run migrations/csv-import/generate-document-review-reports.ts",
    "csv-export:images": "bun run scripts/export-images-csv.ts",
    "csv-export:images:mysql-cli": "bash scripts/export-images-csv.sh",
    "mysql-tunnel": "bash scripts/start-mysql-tunnel.sh",
    "mysql-tunnel:stop": "bash scripts/stop-mysql-tunnel.sh",
    "csv-import:quarterly": "bun run migrations/quarterly-import/import-quarterly.ts",
    "backfill:quarterly-slugs": "bun run migrations/quarterly-import/backfill-article-slugs.ts",
    "csv-import:people": "bun run migrations/charlestown-people/import-people.ts",
    "html-18c:extract": "bun run migrations/html-18c/extract.ts",
    "html-18c:review": "bun run migrations/html-18c/review.ts",
    "html-18c:transform": "bun run migrations/html-18c/transform.ts",
    "html-18c:import": "bun run migrations/html-18c/import.ts",
    "html-18c:validate": "bun run migrations/html-18c/validate.ts",
    "seed:site-navigation": "bun run migrations/seed-site-navigation.ts",
    "seed:featured-images": "bun run migrations/seed-featured-images.ts",
    "audit:validation": "bun run migrations/audit-validation/index.ts",
    "migrations:run": "sanity migrations run",
    "start": "sanity start",
    "lint": "eslint . --fix"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@portabletext/block-tools": "^6.0.5",
    "@sanity/client": "^8.10.1",
    "@sanity/google-maps-input": "^6.1.17",
    "@sanity/icons": "^5.2.3",
    "@sanity/schema": "^6.20.0",
    "@sanity/vision": "6.20.0",
    "csv-parser": "^3.2.1",
    "jsdom": "^30.1.3",
    "linkedom": "^0.18.14",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "p-limit": "^7.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.20.0",
    "styled-components": "^6.6.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "wrangler": "^4.152.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "useTabs": true
  }
}
