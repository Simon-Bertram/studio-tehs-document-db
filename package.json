{
  "name": "tehs-document-db",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "preinstall": "npx only-allow@1.2.2 bun",
    "build": "bun run docs:build && sanity build && bun run docs:dist",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "deploy:worker": "bun run build && wrangler deploy",
    "dev": "sanity dev",
    "docs:build": "bun run --cwd documentation build",
    "docs:dist": "rm -rf dist/documentation dist/_redirects && cp -R documentation/build dist/documentation",
    "docs:dev": "bun run --cwd documentation start",
    "docs:serve": "bun run --cwd documentation serve",
    "preview:worker": "wrangler dev",
    "csv-import": "bun run migrations/csv-import/import-documents.ts",
    "csv-import:donations": "bun run migrations/csv-import/import-donations.ts",
    "csv-import:images": "bun run migrations/csv-import/import-images.ts",
    "csv-export:images": "bun run scripts/export-images-csv.ts",
    "csv-export:images:mysql-cli": "bash scripts/export-images-csv.sh",
    "mysql-tunnel": "bash scripts/start-mysql-tunnel.sh",
    "mysql-tunnel:stop": "bash scripts/stop-mysql-tunnel.sh",
    "csv-import:quarterly": "bun run migrations/quarterly-import/import-quarterly.ts",
    "csv-import:people": "bun run migrations/charlestown-people/import-people.ts",
    "audit:validation": "bun run migrations/audit-validation/index.ts",
    "migrations:run": "sanity migrations run",
    "start": "sanity start",
    "lint": "eslint . --fix"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/client": "^7.26.2",
    "@sanity/google-maps-input": "^6.1.11",
    "@sanity/icons": "^5.2.1",
    "@sanity/vision": "6.9.2",
    "csv-parser": "^3.2.1",
    "linkedom": "^0.18.13",
    "mysql2": "^3.23.3",
    "nanoid": "^6.0.1",
    "p-limit": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "6.9.2",
    "styled-components": "^6.5.2"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "wrangler": "^4.122.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "useTabs": true
  }
}
